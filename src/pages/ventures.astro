---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Ventures — Correct Marketing NG, Chef Daddy Cuisine & AI Projects | Muheeb Sulaiman"
  description="The ventures Muheeb Sulaiman founded and operates: Correct Marketing NG, international student recruitment, Chef Daddy Cuisine, and AI media and storytelling projects."
>
  <div class="projects-hero">
    <div class="container">
      <div class="label">Ventures & Projects</div>
      <h1 class="display-lg" style="color:var(--paper); max-width:700px; margin-bottom:16px;">What I'm Building Beyond the Desk</h1>
      <p class="body-lg">I don't just consult. I operate. Each venture is a real-world application of the systems I preach.</p>
    </div>
  </div>
  <section style="background:var(--ink-90); padding:0 0 120px;">
    <div class="container">
      <div class="projects-full-grid">
        <div class="project-row">
          <div class="project-row__num">01</div>
          <div class="project-row__info">
            <h3>Correct Marketing NG</h3>
            <p>A performance-driven digital marketing agency focused on revenue systems. Services include SEO, paid ads, content strategy, website systems, and automation. Operating across Nigeria and internationally.</p>
            <div style="margin-top:20px; display:flex; gap:12px; flex-wrap:wrap;">
              <span class="authority__tag">Digital Agency</span>
              <span class="authority__tag">Performance Marketing</span>
              <span class="authority__tag">Revenue Systems</span>
            </div>
          </div>
          <div class="project-row__meta">
            <div class="project-row__status">Active</div>
            <span class="project-row__industry">Digital Marketing · Nigeria</span>
            <div style="margin-top:16px;"><a class="btn btn--text" href="/contact">Visit agency</a></div>
          </div>
        </div>
        <div class="project-row">
          <div class="project-row__num">02</div>
          <div class="project-row__info">
            <h3>International Student Recruitment</h3>
            <p>Strategic digital marketing for international higher education recruitment. Building lead generation and nurturing systems that connect prospective students with institutions globally.</p>
            <div style="margin-top:20px; display:flex; gap:12px; flex-wrap:wrap;">
              <span class="authority__tag">Education</span>
              <span class="authority__tag">Lead Generation</span>
              <span class="authority__tag">International Marketing</span>
            </div>
          </div>
          <div class="project-row__meta">
            <div class="project-row__status">Active</div>
            <span class="project-row__industry">Education · Global</span>
          </div>
        </div>
        <div class="project-row">
          <div class="project-row__num">03</div>
          <div class="project-row__info">
            <h3>Chef Daddy Cuisine</h3>
            <p>A food and hospitality brand that I founded and operate — using it as a live laboratory for applying digital marketing, customer acquisition, and retention systems in the offline-meets-online economy.</p>
            <div style="margin-top:20px; display:flex; gap:12px; flex-wrap:wrap;">
              <span class="authority__tag">Food & Hospitality</span>
              <span class="authority__tag">Consumer Brand</span>
              <span class="authority__tag">Local Marketing</span>
            </div>
          </div>
          <div class="project-row__meta">
            <div class="project-row__status">Active</div>
            <span class="project-row__industry">Food · Nigeria</span>
          </div>
        </div>
        <div class="project-row">
          <div class="project-row__num">04</div>
          <div class="project-row__info">
            <h3>AI Media & Storytelling Projects</h3>
            <p>Exploring the intersection of AI, content creation, and digital storytelling. Building systems for next-generation content production — video, narrative, and branded media powered by AI tools.</p>
            <div style="margin-top:20px; display:flex; gap:12px; flex-wrap:wrap;">
              <span class="authority__tag">AI</span>
              <span class="authority__tag">Content & Media</span>
              <span class="authority__tag">Video</span>
            </div>
          </div>
          <div class="project-row__meta">
            <div class="project-row__status">In Development</div>
            <span class="project-row__industry">AI · Media</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
