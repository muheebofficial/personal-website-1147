    .hero__colony-node--two { top: 38%; right: 35%; }
    .hero__colony-node--three { top: 67%; right: 21%; }
    .hero__colony-node--four { top: 74%; right: 40%; }
    .hero__colony-node--five { top: 16%; right: 43%; }

    .hero__colony-ring {
