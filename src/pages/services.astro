---
import Layout from '../layouts/Layout.astro';
import { getServicePath, services } from '../data/services';
import ServicePricing from '../components/ServicePricing.astro';

const categoryOrder = [
  'Strategy', 'Agentic AI', 'Conversational systems', 'Automation', 'AI systems',
  'Revenue systems', 'Conversion systems', 'Lifecycle automation', 'Paid acquisition',
  'Diagnostics', 'Organic growth', 'Web development', 'E-commerce', 'Content',
  'Personal brand', 'Distribution',
];

const grouped = categoryOrder
  .map((category) => ({ category, items: services.filter((service) => service.category === category) }))
  .filter((group) => group.items.length > 0);
---

<Layout
  title="Best Digital Marketing, SEO & AI Services in Nigeria | Muheeb"
  description="Explore the best SEO, digital marketing, website, paid ads and AI automation services in Nigeria. Get a practical growth system tailored to your business."
>
  <div class="services-hero">
    <div class="container">
      <div class="label">Services</div>
      <h1 class="display-lg" style="color:var(--paper); max-width:800px; margin-bottom:20px;">Best Digital Marketing & AI Automation Services in Nigeria</h1>
      <p>Explore Nigeria-focused growth systems across SEO, paid ads, web development, sales automation, and AI.</p>
    </div>
  </div>
  <div class="container" style="padding-bottom:40px;">
    {grouped.map((group) => (
      <section style="margin-top:80px;">
        <div class="label">{group.category}</div>
        <h2 class="display-md">Best {group.category} Services in Nigeria</h2>
        <div class="services-detail-grid">
          {group.items.map((service) => (
            <div class:list={["service-detail-card", { wide: service.includes.length > 4 }]}>
              <div class="service-detail-card__icon">{service.icon}</div>
              <a class="service-detail-card__title service-detail-card__link" href={getServicePath(service)}>{service.title}</a>
              <div class="service-detail-card__desc">{service.intro}</div>
              <div class="service-detail-card__includes" style={service.includes.length > 4 ? 'display:grid; grid-template-columns:1fr 1fr; gap:8px 32px;' : undefined}>
                {service.includes.slice(0, 6).map((item) => <div class="service-detail-card__include">{item}</div>)}
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
  <ServicePricing service={services[0]} compact />
  <section class="section cta-section">
    <div class="cta-section__bg"></div>
    <div class="container">
      <div class="cta-section__content">
        <div class="label" style="justify-content:center;">Get Started</div>
        <h2 class="display-md" style="color:var(--paper); margin-bottom:16px;">Let's Discuss Your Growth in Nigeria</h2>
        <p>I do a free 30-minute diagnostic call for serious enquiries. No pitch. Just a clear read on your situation and what would actually move the needle.</p>
        <div class="cta-section__btns">
          <a class="btn btn--primary btn--lg" href="/contact"><span>→ Book Diagnostic Call</span></a>
          <a href="https://wa.me/2349110172901?text=Hi%20Muheeb%2C%20I%27m%20interested%20in%20your%20services." target="_blank" rel="noopener" class="btn btn--ghost btn--lg"><span>💬 WhatsApp First</span></a>
        </div>
      </div>
    </div>
  </section>
</Layout>
