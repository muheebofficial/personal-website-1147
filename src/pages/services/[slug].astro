---
import Layout from '../../layouts/Layout.astro';
import { services } from '../../data/services';
import ServicePricing from '../../components/ServicePricing.astro';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const isAgentic = service.slug === 'agentic-ai-automation';
const description = isAgentic
  ? 'Agentic AI Automation that answers faster, checks your tools, and follows up with leads while you sleep.'
  : `${service.title} by Muheeb Sulaiman: ${service.intro}`;
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description,
  provider: { '@type': 'Person', name: 'Muheeb Sulaiman', url: new URL('/', Astro.site).href },
  areaServed: 'NG',
  serviceType: service.category,
};
---

<Layout title={`${service.title} | Muheeb Sulaiman`} description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceLd)} />
  <header class="service-detail-hero">
    <div class="container service-detail-hero__grid">
      <div>
        <div class="label">{isAgentic ? 'Agentic AI' : service.category}</div>
        <h1 class="display-lg">{isAgentic ? 'Stop Losing Customers to the Competitor Who Answers Faster' : service.title}</h1>
        <p class="service-detail-hero__intro">{service.intro}</p>
        {isAgentic && (
          <div class="service-detail-hero__actions">
            <a class="btn btn--primary btn--lg" href="/contact"><span>→ Book Diagnostic Call</span></a>
            <a class="btn btn--ghost btn--lg" href="https://wa.me/2349110172901?text=Hi%20Muheeb%2C%20I%20want%20to%20see%20what%20an%20Agentic%20AI%20Automation%20system%20looks%20like%20for%20my%20business." target="_blank" rel="noopener"><span>💬 Reply "AI" on WhatsApp</span></a>
          </div>
        )}
      </div>
      <div class="service-detail-hero__mark" aria-hidden="true">{service.icon}</div>
    </div>
  </header>
  <section class="service-detail-body">
    <div class="container service-detail-body__grid">
      <div>
        <div class="label">The opportunity</div>
        <h2 class="display-md">{isAgentic ? "Here's the secret your competitors won't share with you" : 'Make this part of your growth system.'}</h2>
        <p>{service.problem}</p>
        <div class="service-detail-outcomes" style="margin-top:48px;">
          {service.outcomes.map((outcome, index) => (
            <div class="service-detail-outcome">
              <div class="service-detail-outcome__num">0{index + 1}</div>
              <div class="service-detail-outcome__text">{outcome}</div>
            </div>
          ))}
        </div>
        {isAgentic && <p class="service-detail-opportunity-close">Every hour you or your sales rep spends typing the same answers is an hour stolen from the part of your business that actually grows revenue. Whether you're a solopreneur juggling everything yourself, or a growing business finally ready to focus on what matters — this is for you.</p>}
      </div>
      {isAgentic && (
        <div class="service-detail-callout">
          <div class="label">Let's be clear about what this is</div>
          <p>And no — this isn't a basic chatbot that recites FAQs. This is an AI agent that actually works with the tools you already run your business on — checking stock, confirming orders, updating your CRM, following up on leads — while you sleep.</p>
        </div>
      )}
      <aside class="service-detail-includes">
        <h3>What the work can include</h3>
        <ul>{service.includes.map((item) => <li>{item}</li>)}</ul>
        <p style="color:var(--muted-light); font-size:.85rem; margin-top:28px;">{service.fit}</p>
      </aside>
    </div>
  </section>
  <ServicePricing service={service} />
  <section class="service-detail-next">
    <div class="container service-detail-next__inner">
      <div>
        <div class="label">Start with diagnosis</div>
        <h2 class="display-md">Let’s find the highest-leverage next move.</h2>
        {isAgentic && <p class="service-detail-founder">Hi, I'm Muheeb SulAIman, founder of Correct Marketer NG. I help business owners like you build AI-powered growth systems that attract, qualify, nurture, and convert better leads — automatically.</p>}
        {isAgentic && <p class="service-detail-final-line">Want to see what this looks like for your business? Book a call, or reply "AI" on WhatsApp and let's talk.</p>}
      </div>
      <div style="display:flex; gap:16px; flex-wrap:wrap;">
        <a class="btn btn--primary btn--lg" href="/contact"><span>→ Book Diagnostic Call</span></a>
        <a class="btn btn--ghost btn--lg" href="/services"><span>← All Services</span></a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .service-detail-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 32px;
  }

  .service-detail-opportunity-close {
    margin-top: 28px;
    font-size: .9rem;
  }

  .service-detail-callout {
    grid-column: 1 / -1;
    padding: 32px;
    border: 1px solid var(--gold);
    background: var(--gold-dim);
  }

  .service-detail-callout p {
    max-width: 900px;
    margin-top: 14px;
  }

  .service-detail-founder,
  .service-detail-final-line {
    max-width: 620px;
    margin-top: 20px;
    color: var(--muted-light);
    line-height: 1.8;
  }

  .service-detail-final-line {
    color: var(--paper);
  }

  @media (max-width: 768px) {
    .service-detail-hero__actions {
      align-items: flex-start;
      flex-direction: column;
    }

    .service-detail-callout {
      padding: 24px;
    }
  }
</style>
