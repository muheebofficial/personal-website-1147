---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { services } from '../data/services';

export const prerender = false;

const posts = (await getCollection('blog', ({ data }) => !data.draft)).map((post) => ({
  type: 'Blog',
  title: post.data.title,
  description: post.data.description,
  category: post.data.tags[0] || 'Insight',
  href: `/blog/${post.id}`,
  searchable: [post.data.title, post.data.description, ...post.data.tags].join(' '),
}));

const serviceResults = services.map((service) => ({
  type: 'Service',
  title: service.title,
  description: service.intro,
  category: service.category,
  href: `/services/${service.slug}`,
  searchable: [
    service.title,
    service.intro,
    service.problem,
    service.category,
    ...service.outcomes,
    ...service.includes,
  ].join(' '),
}));

const searchIndex = [...posts, ...serviceResults];
const query = (Astro.url.searchParams.get('q') || '').trim();
const terms = query.toLowerCase().split(/\s+/).filter(Boolean);

const results = terms.length === 0
  ? []
  : searchIndex
    .map((item) => {
      const searchable = item.searchable.toLowerCase();
      const score = terms.reduce((total, term) => {
        const titleScore = item.title.toLowerCase().includes(term) ? 5 : 0;
        const categoryScore = item.category.toLowerCase().includes(term) ? 3 : 0;
        const contentScore = searchable.includes(term) ? 1 : 0;
        return total + titleScore + categoryScore + contentScore;
      }, 0);
      return { ...item, score };
    })
    .filter((item) => item.score > 0)
    .sort((a, b) => b.score - a.score || a.title.localeCompare(b.title));
---

<Layout
  title={query ? `Search results for ${query} | Muheeb Sulaiman` : 'Search | Muheeb Sulaiman'}
  description="Search Muheeb Sulaiman's blog insights and revenue-building services."
>
  <section class="search-page">
    <div class="container">
      <div class="label">Search</div>
      <h1 class="display-lg">Find the right <em>signal.</em></h1>
      <p class="search-page__intro">Search across the blog and services for ideas, systems, and practical ways to grow.</p>

      <form class="search-page__form" action="/search" method="get" role="search">
        <label class="sr-only" for="page-search">Search blog and services</label>
        <input id="page-search" name="q" type="search" value={query} placeholder="Try AI automation, SEO, funnels..." autocomplete="off" autofocus>
        <button class="btn btn--primary" type="submit"><span>Search <span aria-hidden="true">→</span></span></button>
      </form>

      {query && <p class="search-page__summary">{results.length} {results.length === 1 ? 'result' : 'results'} for <strong>“{query}”</strong></p>}

      {query && results.length > 0 ? (
        <div class="search-results">
          {results.map((result) => (
            <a class="search-result" href={result.href}>
              <div class="search-result__type">{result.type} · {result.category}</div>
              <h2>{result.title}</h2>
              <p>{result.description}</p>
              <span class="search-result__link">Explore <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      ) : query ? (
        <div class="search-page__empty">
          <h2>No matching content yet.</h2>
          <p>Try a broader search such as “marketing”, “AI”, or “growth”.</p>
        </div>
      ) : (
        <div class="search-page__empty">
          <h2>Search the knowledge base.</h2>
          <p>Use the field above to search published insights and available services.</p>
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .search-page {
    min-height: 72vh;
    padding: 144px 0 120px;
    background: var(--ink);
    color: var(--paper);
  }

  .search-page h1 {
    max-width: 760px;
    margin: 18px 0 20px;
    color: var(--paper);
  }

  .search-page h1 em {
    color: var(--gold);
    font-style: italic;
  }

  .search-page__intro {
    max-width: 620px;
    color: var(--muted-light);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .search-page__form {
    display: flex;
    max-width: 780px;
    gap: 12px;
    margin: 48px 0 24px;
  }

  .search-page__form input {
    min-width: 0;
    flex: 1;
    padding: 17px 20px;
    border: 1px solid rgba(201, 167, 108, .3);
    border-radius: 0;
    outline: 0;
    background: rgba(245, 240, 232, .06);
    color: var(--paper);
    font: 500 1rem var(--ff-body);
  }

  .search-page__form input:focus {
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(201, 167, 108, .1);
  }

  .search-page__form input::placeholder {
    color: var(--muted);
  }

  .search-page__summary {
    margin: 28px 0;
    color: var(--muted-light);
    font-size: .85rem;
  }

  .search-page__summary strong {
    color: var(--paper);
    font-weight: 600;
  }

  .search-results {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2px;
    max-width: 1040px;
    margin-top: 16px;
  }

  .search-result {
    display: flex;
    min-height: 250px;
    flex-direction: column;
    padding: 30px;
    border: 1px solid rgba(245, 240, 232, .08);
    background: var(--ink-mid);
    transition: border-color .25s var(--ease), background .25s var(--ease), transform .25s var(--ease);
  }

  .search-result:hover,
  .search-result:focus-visible {
    border-color: rgba(201, 167, 108, .55);
    background: rgba(201, 167, 108, .08);
    transform: translateY(-3px);
  }

  .search-result__type {
    margin-bottom: 24px;
    color: var(--gold);
    font-size: .65rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .search-result h2 {
    margin-bottom: 14px;
    color: var(--paper);
    font: 400 2rem/1.05 var(--ff-display);
  }

  .search-result p {
    color: var(--muted-light);
    font-size: .85rem;
    line-height: 1.7;
  }

  .search-result__link {
    margin-top: auto;
    padding-top: 26px;
    color: var(--gold);
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .search-page__empty {
    max-width: 620px;
    margin-top: 48px;
    padding: 36px 0;
    border-top: 1px solid rgba(245, 240, 232, .12);
  }

  .search-page__empty h2 {
    margin-bottom: 12px;
    color: var(--paper);
    font: 400 2.4rem/1 var(--ff-display);
  }

  .search-page__empty p {
    color: var(--muted-light);
    line-height: 1.7;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 700px) {
    .search-page { padding: 112px 0 80px; }
    .search-page__form { flex-direction: column; align-items: stretch; }
    .search-page__form .btn { align-self: flex-start; }
    .search-results { grid-template-columns: 1fr; }
  }
</style>
