---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found — Muheeb Sulaiman"
  description="That page doesn't exist. Head back to the homepage, the services, or the Blog archive."
>
  <section class="section" style="background:var(--ink); text-align:center;">
    <div class="container">
      <div class="label" style="justify-content:center;">404</div>
      <h1 class="display-lg" style="color:var(--paper); margin-bottom:16px;">This Page Doesn't Exist</h1>
      <p class="body-lg" style="max-width:520px; margin:0 auto 40px;">The link is broken or the page has moved. Here's where to go instead.</p>
      <div class="cta-section__btns" style="justify-content:center;">
        <a class="btn btn--primary btn--lg" href="/"><span>→ Back Home</span></a>
        <a class="btn btn--ghost btn--lg" href="/blog"><span>Read Insights</span></a>
      </div>
    </div>
  </section>
</Layout>
