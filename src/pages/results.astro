---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Results — Case Studies in Revenue, Leads & Compounding Growth | Muheeb Sulaiman"
  description="Real outcomes from revenue systems: 312% organic traffic growth, 4.8x ROAS, ₦18M attributed revenue, 850+ qualified leads. Case studies across e-commerce, education, and hospitality."
>
  <section class="section" style="background:var(--ink); padding-bottom:0;">
    <div class="container">
      <div class="label">Results</div>
      <h1 class="display-lg" style="color:var(--paper); max-width:700px; margin-bottom:16px;">Systems That Delivered Real Outcomes</h1>
      <p class="body-lg">Not impressions. Not followers. Revenue, leads, and compounding growth.</p>
    </div>
  </section>
  <section style="background:var(--ink-90); padding:80px 0 120px;">
    <div class="container">
      <div class="cases__grid">
        <div class="case-card case-card--featured">
          <div>
            <div class="case-card__label">Case Study 01 · Digital Agency</div>
            <div class="case-card__client">E-commerce Brand Scale</div>
            <div class="case-card__type">Performance Marketing + SEO System</div>
            <div class="case-card__metrics">
              <div><div class="case-metric__val">312%</div><div class="case-metric__label">Organic traffic increase</div></div>
              <div><div class="case-metric__val">4.8x</div><div class="case-metric__label">ROAS on paid ads</div></div>
              <div><div class="case-metric__val">₦18M</div><div class="case-metric__label">Revenue attributed in 6 months</div></div>
            </div>
          </div>
          <div>
            <p class="case-card__summary">An e-commerce brand running disconnected ads with no tracking and an underperforming website. Built a complete revenue system: technical SEO overhaul, new landing pages, retargeting sequences, and a Meta Ads funnel with proper attribution. Within 6 months, organic traffic tripled and paid ads were running profitably at 4.8x ROAS.</p>
            <div style="margin-top:24px;">
              <div class="label label--light" style="margin-bottom:8px;">Approach</div>
              <p style="font-size:.875rem; color:var(--muted); line-height:1.7;">Audit → Fix technical foundation → Build content assets → Launch and optimise paid system → Scale.</p>
            </div>
          </div>
          <div class="case-card__arrow">→</div>
        </div>

        <div class="case-card">
          <div class="case-card__label">Case Study 02 · Education</div>
          <div class="case-card__client">International Student Recruitment</div>
          <div class="case-card__type">Lead Generation System</div>
          <div class="case-card__metrics">
            <div><div class="case-metric__val">850+</div><div class="case-metric__label">Qualified leads generated</div></div>
            <div><div class="case-metric__val">67%</div><div class="case-metric__label">Cost per lead reduction</div></div>
          </div>
          <p class="case-card__summary">Built a targeted lead generation system for international university recruitment — Facebook and Instagram ads, landing pages, WhatsApp automation for lead nurturing, and CRM integration.</p>
          <div class="case-card__arrow">→</div>
        </div>

        <div class="case-card">
          <div class="case-card__label">Case Study 03 · Food & Hospitality</div>
          <div class="case-card__client">Chef Daddy Cuisine</div>
          <div class="case-card__type">Brand + Digital Growth System</div>
          <div class="case-card__metrics">
            <div><div class="case-metric__val">5x</div><div class="case-metric__label">Instagram following growth</div></div>
            <div><div class="case-metric__val">2.1x</div><div class="case-metric__label">Revenue increase YoY</div></div>
          </div>
          <p class="case-card__summary">Built the digital brand and growth engine for Chef Daddy Cuisine — social media strategy, food content system, WhatsApp ordering funnel, and Google My Business optimisation.</p>
          <div class="case-card__arrow">→</div>
        </div>
      </div>
    </div>
  </section>
  <section class="section cta-section">
    <div class="cta-section__bg"></div>
    <div class="container">
      <div class="cta-section__content">
        <div class="label" style="justify-content:center;">Your Result</div>
        <h2 class="display-md" style="color:var(--paper); margin-bottom:16px;">Want Results Like These?</h2>
        <p>Let's diagnose your growth situation and identify the highest-leverage system to build first.</p>
        <div class="cta-section__btns">
          <a class="btn btn--primary btn--lg" href="/contact"><span>→ Start the Conversation</span></a>
        </div>
      </div>
    </div>
  </section>
</Layout>
