---
const path = Astro.url.pathname;

const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/results', label: 'Results' },
  { href: '/blog', label: 'Insights' },
  { href: '/ventures', label: 'Ventures' },
];

const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<!-- ======= NAV ======= -->
<nav class="nav" role="navigation">
  <div class="nav__inner">
    <a class="nav__logo" href="/">
      <div class="nav__logo-dot"></div>
      Muheeb Sulaiman
    </a>
    <ul class="nav__links">
      {links.map((l) => (
        <li>
          <a
            class:list={['nav__link', { active: isActive(l.href) }]}
            href={l.href}
            aria-current={isActive(l.href) ? 'page' : undefined}
          >{l.label}</a>
        </li>
      ))}
    </ul>
    <div class="nav__cta">
      <a class="btn btn--primary" href="/contact"><span>Work With Me</span></a>
    </div>
    <button class="nav__hamburger" id="hamburger" type="button" aria-label="Menu" aria-controls="mobMenu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<div class="mob-menu" id="mobMenu">
  {links.map((l) => <a href={l.href}>{l.label}</a>)}
  <a href="/contact">Contact</a>
</div>

<style>
  /* Hamburger was a <div> in the original markup; it is a <button> now for
     keyboard access. Strip the default button chrome so it looks identical. */
  .nav__hamburger {
    background: none;
    border: 0;
    font: inherit;
    color: inherit;
    align-items: center;
  }
</style>
