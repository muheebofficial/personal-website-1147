---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Layout from './Layout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  cover?: ImageMetadata;
  coverAlt?: string;
  tags?: string[];
  slug: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  cover,
  coverAlt,
  tags = [],
  slug,
} = Astro.props;

const url = new URL(`/blog/${slug}`, Astro.site).href;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: {
    '@type': 'Person',
    name: 'Muheeb Sulaiman',
    url: new URL('/about', Astro.site).href,
  },
  publisher: { '@type': 'Organization', name: 'Correct Marketing NG' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  url,
  ...(tags.length && { keywords: tags.join(', ') }),
};
---

<Layout title={`${title} — Muheeb Sulaiman`} description={description} image={cover?.src} type="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <article class="section--sm post">
    <div class="container post__inner">
      <a class="post__back" href="/blog">Back to Insights</a>

      {tags.length > 0 && <div class="post__cat">{tags[0]}</div>}
      <h1 class="post__title">{title}</h1>

      <div class="post__meta">
        <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
        {updatedDate && <span> · Updated {fmt(updatedDate)}</span>}
      </div>

      {cover && (
        <Image class="post__cover" src={cover} alt={coverAlt ?? ''} widths={[640, 960, 1280]} sizes="(max-width: 860px) 100vw, 860px" />
      )}

      <div class="post__body">
        <slot />
      </div>

      {tags.length > 0 && (
        <div class="post__tags">
          {tags.map((t) => <span class="authority__tag">{t}</span>)}
        </div>
      )}
    </div>
  </article>

  <section class="section cta-section">
    <div class="cta-section__bg"></div>
    <div class="container">
      <div class="cta-section__content">
        <div class="label" style="justify-content:center;">Start Here</div>
        <h2 class="display-md" style="color:var(--paper); margin-bottom:16px;">Want This Built Into Your Business?</h2>
        <p>If the ideas here match the problem you're sitting on, let's talk about the system that would fix it.</p>
        <div class="cta-section__btns">
          <a class="btn btn--primary btn--lg" href="/contact"><span>→ Book a Strategy Call</span></a>
          <a class="btn btn--ghost btn--lg" href="/blog"><span>Read More Insights</span></a>
        </div>
      </div>
    </div>
  </section>
  <div class="container">
    <NewsletterSignup compact />
  </div>
</Layout>

<style>
  /* Article typography only — global.css carries the site design untouched,
     and it has no rules for long-form markdown output. */
  .post { background: var(--ink); padding-bottom: 96px; }
  .post__inner { max-width: 820px; }

  .post__back {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: .72rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase;
    color: var(--muted); margin-bottom: 40px; transition: color .2s var(--ease);
  }
  .post__back::before { content: '←'; }
  .post__back:hover { color: var(--gold); }

  .post__cat {
    font-size: .7rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase;
    color: var(--gold); margin-bottom: 20px;
  }

  .post__title {
    font-family: var(--ff-display);
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: 400; line-height: 1.12; letter-spacing: -.01em;
    color: var(--paper); margin-bottom: 20px;
  }

  .post__meta {
    font-size: .78rem; color: rgba(245,240,232,.35);
    padding-bottom: 32px; border-bottom: 1px solid rgba(201,167,108,.15);
    margin-bottom: 48px;
  }

  .post__cover { width: 100%; height: auto; margin-bottom: 48px; }

  .post__body { font-size: 1.0625rem; line-height: 1.85; color: var(--muted-light); }
  .post__body :global(p) { margin-bottom: 28px; }
  .post__body :global(h2) {
    font-family: var(--ff-display); font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 400; line-height: 1.25; color: var(--paper);
    margin: 64px 0 20px;
  }
  .post__body :global(h3) {
    font-family: var(--ff-body); font-size: 1.05rem; font-weight: 600;
    letter-spacing: .01em; color: var(--paper); margin: 44px 0 14px;
  }
  .post__body :global(ul),
  .post__body :global(ol) { margin: 0 0 28px 0; padding-left: 22px; }
  .post__body :global(ul) { list-style: none; padding-left: 0; }
  .post__body :global(ul li) { position: relative; padding-left: 22px; margin-bottom: 12px; }
  .post__body :global(ul li)::before {
    content: '—'; position: absolute; left: 0; color: var(--gold);
  }
  .post__body :global(ol) { list-style: decimal; }
  .post__body :global(ol li) { margin-bottom: 12px; padding-left: 6px; }
  .post__body :global(ol li)::marker { color: var(--gold); font-weight: 600; }
  .post__body :global(strong) { color: var(--paper); font-weight: 600; }
  .post__body :global(em) { font-family: var(--ff-display); font-style: italic; }
  .post__body :global(a) {
    color: var(--gold); border-bottom: 1px solid rgba(201,167,108,.35);
    transition: border-color .2s var(--ease);
  }
  .post__body :global(a:hover) { border-bottom-color: var(--gold); }
  .post__body :global(blockquote) {
    font-family: var(--ff-display); font-size: clamp(1.25rem, 2.4vw, 1.6rem);
    font-style: italic; line-height: 1.5; color: var(--paper);
    border-left: 2px solid var(--gold); padding-left: 28px;
    margin: 48px 0;
  }
  .post__body :global(blockquote p) { margin-bottom: 0; }
  .post__body :global(img) { width: 100%; height: auto; margin: 40px 0; }
  .post__body :global(hr) {
    border: 0; height: 1px; background: rgba(201,167,108,.15); margin: 56px 0;
  }
  .post__body :global(code) {
    font-size: .9em; background: var(--ink-mid); color: var(--gold-light);
    padding: 2px 6px; border: 1px solid rgba(201,167,108,.12);
  }
  .post__body :global(pre) {
    background: var(--ink-mid); border: 1px solid rgba(245,240,232,.06);
    padding: 24px; overflow-x: auto; margin-bottom: 28px;
  }
  .post__body :global(pre code) { background: none; border: 0; padding: 0; }

  .post__tags {
    display: flex; gap: 12px; flex-wrap: wrap;
    margin-top: 64px; padding-top: 40px;
    border-top: 1px solid rgba(201,167,108,.15);
  }
</style>
